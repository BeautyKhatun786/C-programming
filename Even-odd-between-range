#include<stdio.h>
#include<stdlib.h>

int main()
{
    int n1,n2,r,i;
    printf("Enter the first number for the range:");
    scanf("%d",&n1);
    printf("Enter the first number for the range:");
    scanf("%d",&n2);
    
    printf("Display the the even number between %d and %d\n",n1,n2);
    for(i=n1;i<=n2;i++)
    {
        r=i%2;
        if(r==0)
        printf("%d\n",i);
    }
    
    printf("Display the the odd number between %d and %d\n",n1,n2);
    for(i=n1;i<=n2;i++)
    {
        r=i%2;
        if(r==1)
        printf("%d\n",i);
    }
    
    return 0;
}
